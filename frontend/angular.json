{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "gestion-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": { "builder": "@angular/build:application", "options": { "outputPath": "dist/gestion-frontend", "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "polyfills": ["zone.js"], "styles": ["src/styles.scss"] }, "configurations": { "production": { "optimization": true, "outputHashing": "all" }, "development": { "optimization": false, "sourceMap": true } }, "defaultConfiguration": "production" },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "gestion-frontend:build:production" }, "development": { "buildTarget": "gestion-frontend:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
